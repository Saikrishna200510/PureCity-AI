rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Citizen pollution report images scoped strictly to the uploading user's folder
    match /pollution-reports/{userId}/{fileName} {
      // Verified reports or owner's own uploads can be read by authenticated users
      allow read: if request.auth != null;
      // Only the authenticated owner can upload images <= 5 MB with an image MIME type
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource != null
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|jpeg|jpg|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
