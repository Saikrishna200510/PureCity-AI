# Firebase Web App Configuration (Get from Firebase Console -> Project Settings -> Your Apps)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Set to 'true' when running Firebase Local Emulator Suite
VITE_USE_EMULATORS=false

# Optional: Set to 'true' when Cloud Functions are deployed (Blaze plan) or running in emulators
VITE_ENABLE_FUNCTIONS_API=false

# Optional: WAQI (World Air Quality Index) token for ground station real-time AQI
# Obtain free token at https://aqicn.org/data-platform/token/
# VITE_WAQI_API_TOKEN=your_waqi_token

# Optional: Override Cloud Functions API base URL (defaults to '/api' via Hosting rewrite / Vite proxy)
# VITE_API_BASE_URL=https://us-central1-your-project-id.cloudfunctions.net/api
