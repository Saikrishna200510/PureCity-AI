# Google Gemini API Key (Required for AI Air Quality Assistant)
# Obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Optional: OpenAQ API v3 Key for ground-level monitoring station data
# Obtain free key from https://explore.openaq.org/register
OPENAQ_API_KEY=your_openaq_api_key
